NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. Used by the AI analysis pipeline (src/lib/ai/analyze.ts).
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key

# Server-only. Lets the ingestion and analysis routes (src/app/api/*) bypass
# RLS to write on behalf of the scheduler/cron rather than a logged-in user.
# Service role key, from Supabase project settings > API.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret required in the `x-cron-secret` header by /api/cron/* routes,
# so ingestion/analysis can't be triggered by anyone who finds the URL.
CRON_SECRET=generate-a-random-string
