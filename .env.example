# ---- Required ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. Powers AI content analysis and the discovery engine.
# Without it the app still runs: ingestion, search, alerts-from-rules and all
# CRUD work, but analysis/discovery return a clear "not configured" message.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key

# ---- Optional ----
# Only needed for the SCHEDULED cron sweeps (src/app/api/cron/*), which run
# across every user and so cannot use any one user's session. The in-app
# "Sync now" and "Run discovery" buttons work without it, on the signed-in
# user's own RLS-scoped session.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret required in the `x-cron-secret` header by /api/cron/* routes,
# so ingestion/analysis can't be triggered by anyone who finds the URL.
# CRON_SECRET=generate-a-random-string

# Override the models used by the AI pipeline.
# ANTHROPIC_ANALYSIS_MODEL=claude-haiku-4-5
# ANTHROPIC_DISCOVERY_MODEL=claude-sonnet-5
